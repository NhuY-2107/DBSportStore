@model DBSportStore.Models.StoreHomeViewModel
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<!-- ===== HERO BANNER ===== -->
<section class="hero">
    <div>
        <p>NEW SEASON / SPORT & ACTIVE</p>
        <h1>Move better. Train stronger.</h1>
        <p>Khám phá bộ sưu tập thể thao dành cho tập luyện, thi đấu và phong cách sống năng động.</p>
        <a class="btn-brand" href="#featured-products">Mua sắm ngay</a>
    </div>
</section>

<!-- Tiêu đề khu vực sản phẩm nổi bật -->
<h2 class="section-title">Sản phẩm nổi bật</h2>

<div class="catalog-toolbar">
    @using (Html.BeginForm(
        "Index",
        "Store",
        FormMethod.Get,
        new { @class = "catalog-search" }))
    {
        @* Giữ categoryId khi tìm kiếm *@
        if (Model.SelectedCategoryId.HasValue)
        {
            <input type="hidden"
                   name="categoryId"
                   value="@Model.SelectedCategoryId" />
        }

        <input type="text"
               name="keyword"
               value="@Model.SearchTerm"
               placeholder="Tìm tên hoặc mô tả sản phẩm..." />

        @* giá tối thiểu; có thể để trống *@
        <input type="number"
               name="minPrice"
               value="@Model.MinPrice"
               min="0"
               step="1000"
               placeholder="Giá từ" />

        @* giá tối đa; có thể để trống *@
        <input type="number"
               name="maxPrice"
               value="@Model.MaxPrice"
               min="0"
               step="1000"
               placeholder="Giá đến" />

        @* ⭐ BÀI 2: Dropdown sắp xếp theo giá *@
        <select name="sortOrder" class="form-control-modern" onchange="this.form.submit()" style="padding: 0 10px; border-radius: 4px; border: 1px solid #cbd5e1; height: 40px; background: #fff;">
            <option value="">-- Sắp xếp theo giá --</option>
            <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá: Thấp → Cao</option>
            <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá: Cao → Thấp</option>
        </select>

        <button type="submit" class="btn-brand">
            Tìm kiếm
        </button>

        <a class="btn-soft"
           href="@Url.Action("Index", "Store")">
            Xóa lọc
        </a>
    }
</div>

<!-- ===== KHUNG CHÍNH: danh mục trái + sản phẩm phải ===== -->
<div class="store-shell" id="featured-products">
    <!-- Danh mục động từ database -->
    <aside class="category-panel" id="category-panel">
        <h3>Danh mục</h3>

        <ul class="category-list">
            <!-- ⭐ BÀI 3: Highlight nút "Tất cả sản phẩm" khi không chọn danh mục nào -->
            <li>
                <a href="@Url.Action("Index", "Store", new { keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder })"
                   class="@(Model.SelectedCategoryId == null ? "active" : "")">
                    Tất cả sản phẩm
                </a>
            </li>

            @foreach (var category in Model.Categories)
            {
                @* ⭐ BÀI 3: Kiểm tra nếu danh mục đang lặp trùng với ID đang chọn thì gắn class "active" *@
                var isActive = (Model.SelectedCategoryId == category.CategoryID) ? "active" : "";

                <li>
                    <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = category.CategoryID,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder
                        })"
                       class="@isActive">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section>
        @* ===== DANH SÁCH SẢN PHẨM ===== *@
        @if (Model.Products != null && Model.Products.Any())
        {
            @* BÀI 1: Hiển thị dòng thông báo số lượng kết quả *@
            <div style="margin-bottom: 15px; font-weight: 600; color: #64748b;">
                Tìm thấy @Model.TotalItems sản phẩm
            </div>
            <div class="product-grid">
                @foreach (var item in Model.Products)
                {
                    <article class="product-card">
                        <div class="product-image">
                            <img src="~/Content/images/@item.ImagePro" alt="@item.NamePro" />
                        </div>
                        <div class="product-body">
                            <div style="color:#64748b;font-size:13px;">@item.CategoryName</div>
                            <div class="product-name">@item.NamePro</div>
                            <div class="product-price">@item.Price.ToString("#,##0") đ</div>
                            <div class="product-actions">
                                @Html.ActionLink(
                                    "Chi tiết",
                                    "Details",
                                    "Products",
                                    new { id = item.ProductID },
                                    new { @class = "btn-soft" }
                                )
                                <a class="btn-brand" href="#">Mua</a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            @* ==================== PHÂN TRANG ==================== *@
            if (Model.TotalPages > 1)
            {
                <div class="store-pagination">
                    @* Nút quay về trang trước *@
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder,
                            page = Model.CurrentPage - 1
                        })">
                            ← Trước
                        </a>
                    }

                    @* Hiển thị các số trang *@
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="active">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action(
                            "Index",
                            "Store",
                            new
                            {
                                categoryId = Model.SelectedCategoryId,
                                keyword = Model.SearchTerm,
                                minPrice = Model.MinPrice,
                                maxPrice = Model.MaxPrice,
                                sortOrder = Model.SortOrder,
                                page = i
                            })">
                                @i
                            </a>
                        }
                    }

                    @* Nút sang trang kế tiếp *@
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder,
                            page = Model.CurrentPage + 1
                        })">
                            Sau →
                        </a>
                    }
                </div>
            }
        }
        else
        {
            @* Thông báo khi không có sản phẩm phù hợp *@
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>Không có sản phẩm nào phù hợp với các điều kiện lọc hoặc từ khóa đang chọn.</p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">
                    Xem tất cả sản phẩm
                </a>
            </div>
        }
    </section>
</div>